BasicInfo:
  Title                   : romm3ds
  ProductCode             : CTR-P-RMDS
  Logo                    : Homebrew

RomFs:
  RootPath                : romfs

TitleInfo:
  Category                : Application
  UniqueId                : 0xFF3FF

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCrypt             : false
  EnableCompress          : true

AccessControlInfo:
  CoreVersion                   : 2
  DescVersion                   : 2
  ReleaseKernelMajor            : "02"
  ReleaseKernelMinor            : "33"

  MemoryType                    : Application
  SystemModeExt                 : "Legacy"
  IdealProcessor                : 0
  AffinityMask                  : 1
  Priority                      : 16
  MaxCpu                        : 0x9E

  # heap + linear/qtm memory
  SystemMode                    : 64MB

  DisableDebug                  : false
  EnableForceDebug              : false
  CanWriteSharedPage            : true
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : true
  PermitMainFunctionArgument    : true
  CanShareDeviceMemory          : true
  RunnableOnSleep               : false
  SpecialMemoryArrange          : true

  # FS access + services this app needs
  FileSystemAccess:
   - DirectSdmc
   - CategorySystemApplication
   - CategoryFileSystemTool
   - CtrNandRo
   - CtrNandRw
   - Boss

  IoAccessControl:

  ServiceAccessControl:
   - APT:U
   - $hioFIO
   - $hostio0
   - $hostio1
   - ac:u
   - am:net
   - boss:U
   - cfg:u
   - fs:USER
   - gsp::Gpu
   - hid:USER
   - http:C
   - ndm:u
   - ns:s
   - nwm::UDS
   - ptm:u
   - soc:U
   - ssl:C
   - y2r:u
   - cecd:u
   - frd:u
   - ir:USER
   - ir:u
   - ir:rst
   - news:s
   - csnd:SND

